{
  "$schema": "https://json.schemastore.org/electron-builder.json",
  "appId": "com.ymtj.nota",
  "productName": "Nota",
  "copyright": "Copyright © 2026 YMTJ0522",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "compression": "maximum",
  "afterPack": "./scripts/after-pack.cjs",
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "!node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "build/icon.png",
      "to": "icon.png"
    },
    {
      "from": "build/icon.ico",
      "to": "icon.ico"
    },
    {
      "from": "install",
      "to": "install"
    }
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.ico",
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "mac": {
    "target": [
      "dmg"
    ],
    "icon": "build/icon.png",
    "category": "public.app-category.productivity"
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "icon": "build/icon.png",
    "category": "Office"
  }
}

node_modules/
dist/
dist-electron/
# 性能剖析专用的未压缩构建产物（scripts/diag-profile.mjs 用的靶子）
dist-prof/
release/
*.tsbuildinfo
*.log
.DS_Store
.vite/

# 验证脚本产生的临时浏览器 profile
.tmp-*

# 验证脚本产出的中间截图（只保留 README 用的那两张）
docs/probe-*.png

# clean.mjs / release.mjs 用改名代替删除而挪走的旧目录
.trash/

# 预览/导出缓存（主进程按笔记 hash 建的临时目录，运行时自己会涨）
.preview/
test-output/

# 手搓的临时探针脚本，不属于项目
test-*.mjs
test-*.ts
test-*.md
esbuild-test.mjs

# publish-github.mjs 发版时临时拼的 Release 正文（用完即删）
.tmp-release-body.json

# python 编译缓存（remote-deploy.py / serve.py 会生成）
__pycache__/
*.pyc

# 宣传片渲染的中间产物（逐帧截出来的图，随时能重出）
promo/stills/
promo/demo-stills/

# 封面渲染出来的成品（重新跑 scripts/render-cover.mjs 就有）
promo/cover-43.png
